generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RECRUITER
  CANDIDATE
  ENTERPRISE
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  telephone String?
  password  String
  role      Role      @default(CANDIDATE)
  createdAt DateTime  @default(now())
  vacancies Vacancy[]
  resumes   Resume[]
}

model Vacancy {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetaFeaturedJob String
  jobTitle           String
  enterprise         String
  location           String
  modality           String
  wage               String
  typeOfContract     String
  workShift          String
  workSchedule       String
  daysWorkedPerWeek  String
  workTime           String
  skills             String[]
  education          String
  descriptionVacancy String
  requirements       String[]
  differences        String[]
  activities         String[]
  benefits           String[]
  resumes            Resume[]
  createdAt          DateTime @default(now())
}

model Resume {
  id        Int      @id @default(autoincrement())
  url       String
  createdAt DateTime @default(now())
  vacancyId Int
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
